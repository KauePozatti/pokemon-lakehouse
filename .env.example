# Copie para .env e preencha. NUNCA versione o .env.
# Endpoint e chaves chegam pelo canal da turma.

# "s3" grava no RustFS/MinIO da turma; "local" grava em LOCAL_ROOT (desenvolvimento e demo).
POKELAKE_BACKEND=s3
S3_ENDPOINT_URL=https://lake-aulas-mackenzie.afonsolelis.tech
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=tcg
S3_REGION=us-east-1

# Sua coleção (confira antes se o group_id já existe em tcg/raw/tcgplayer/)
COLECAO_SIGLA=DRI
RESPONSAVEL=Seu Nome

# Parâmetro do desafio da carteira (hipótese declarada no ADR-006)
TAXA_VENDA=0.15

# Só para POKELAKE_BACKEND=local
LOCAL_ROOT=data_local
